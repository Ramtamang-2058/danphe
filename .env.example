# Copy to .env and fill in your keys
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional: force a specific model instead of auto-routing
# DANPHE_MODEL=fast|long|reasoning|groq|auto

# Optional: max tokens per call (default 16384)
# DANPHE_MAX_TOKENS=16384

# Optional: show full prompt sent to LLM (debug)
# DANPHE_DEBUG=1
